# Database
DATABASE_URL="file:./db/custom.db"
# DATABASE_URL_POSTGRES="postgresql://postgres:admin@localhost:5432/solaros?schema=public"

# Auth
AUTH_SECRET="change-this-to-a-secure-random-secret-key-32chars"
APP_BASE_URL="http://localhost:3000"

# S3 / MinIO Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="solaros-media"
S3_ACCESS_KEY_ID="minio_admin"
S3_SECRET_ACCESS_KEY="minio_password"

# Cron Secret
CRON_SECRET="cron-secret-token-change-in-production"

# Email Services
EMAIL_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="SolarOS <onboarding@resend.dev>"
ADMIN_EMAIL="admin@solaros.internal"

# SMS (MSG91)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Razorpay Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# AI / Vision (Gemini)
GEMINI_API_KEY=""
AI_API_KEY=""
AI_MODEL="gemini-flash-latest"

# Observability & Config
SENTRY_DSN=""
APP_TIMEZONE="Asia/Kolkata"
