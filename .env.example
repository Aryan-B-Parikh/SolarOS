# Database (Host port is 5433 when running via Docker Compose)
DATABASE_URL="postgresql://solaros_user:solaros_password@localhost:5433/solaros?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="e9b21f375f4c9c6122d2c13d78c66e2c38865f97973c1d9b32c668749aef46e8"
